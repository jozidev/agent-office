{
  "name": "agent-office",
  "version": "0.1.0",
  "description": "Manage Claude Code agents as characters in an isometric office",
  "type": "module",
  "bin": {
    "agent-office": "./dist/index.js"
  },
  "files": [
    "dist",
    "ui",
    "scripts"
  ],
  "scripts": {
    "postinstall": "node scripts/fix-pty-permissions.mjs",
    "build": "tsup && rm -rf ui && cp -r ../../packages/ui/dist ui && mkdir -p scripts && cp ../../scripts/fix-pty-permissions.mjs scripts/",
    "typecheck": "tsc --noEmit",
    "test": "echo 'no cli tests yet'"
  },
  "dependencies": {
    "node-pty": "^1.1.0",
    "better-sqlite3": "^11.5.0"
  },
  "devDependencies": {
    "@agent-office/server": "workspace:*",
    "@agent-office/shared": "workspace:*",
    "@types/node": "^22.7.0",
    "tsup": "^8.3.0",
    "typescript": "^5.6.0"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT"
}
